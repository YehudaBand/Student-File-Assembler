# --- Google Drive (required) ---
# Root Drive folder containing one subfolder per student (LastName_FirstName)
GDRIVE_ROOT_FOLDER_ID=

# Drive folder where assembled PDFs get uploaded (strongly recommended for cloud deploy)
GDRIVE_OUTPUT_FOLDER_ID=

# --- Local / serverless paths ---
# Local output directory (defaults to ./output locally, /tmp/hcm2-output on Vercel)
OUTPUT_DIR=./output

# Roster JSON file path (defaults to ./roster.json). On Vercel use /tmp/roster.json (ephemeral).
# ROSTER_STORE_PATH=/tmp/roster.json

# Optional: seed roster from env on first boot (single-line JSON). Prefer external DB for production.
# ROSTER_JSON=

# Port for local Flask UI
PORT=5055

# --- Google Drive OAuth (serverless / shared service account) ---
# Option A: paste full token.json contents (includes refresh_token)
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/drive"]}

# Option B: refresh token + web client credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Google Workspace app login (optional, recommended for team deploy) ---
# GOOGLE_AUTH_ENABLED=1
# GOOGLE_ALLOWED_DOMAIN=masterschool.com
# APP_BASE_URL=https://your-app.vercel.app
# FLASK_SECRET_KEY=generate-a-long-random-string
